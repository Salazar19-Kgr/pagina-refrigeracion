{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pagina-refrigeracion",
  "main": "worker.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "13e37767-df5e-4a5a-8407-0fb359d68bfd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TRABAJOS",
      "bucket_name": "refrigeracion-barinas-fotos"
    }
  ]
}
